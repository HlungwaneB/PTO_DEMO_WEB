@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password"; ViewData["Mode"] = "auth";
}
<section class="auth-card">
    <img class="bars" src="~/images/mangaung-mark.png" alt="Mangaung" />   
    <h1>Reset password</h1>
    <p style="font-size:.8rem;margin:0 0 18px 0">Type the 6-digit code from your e-mail (valid for about 10 minutes) and choose a new password.</p>
    <form asp-action="ResetPassword" method="post" data-once>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="af">
            <label asp-for="Code">Verification code</label>
            <input asp-for="Code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
            <span asp-validation-for="Code" class="field-error"></span>
        </div>
        <div class="af">
            <label asp-for="Password">New password</label>
            <input asp-for="Password" autocomplete="new-password" />
            <span style="font-size:.7rem">At least 8 characters with an upper-case letter, a lower-case letter and a number.</span>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="af">
            <label asp-for="ConfirmPassword">Confirm password</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="login-btn">CHANGE PASSWORD</button>
    </form>
    <p class="alt">No code? <a asp-action="ForgotPassword">Send a new code</a></p>
</section>