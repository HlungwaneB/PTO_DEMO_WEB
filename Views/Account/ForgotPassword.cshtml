@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password"; ViewData["Mode"] = "auth";
}
<section class="auth-card">
    <svg class="bars" viewBox="0 0 28 36" aria-hidden="true"><rect x="0" y="14" width="7" height="22" rx="3" fill="#F26B21" /><rect x="10" y="0" width="7" height="36" rx="3" fill="#111" /><rect x="20" y="8" width="7" height="28" rx="3" fill="#7A9A0E" /></svg>
    <h1>Forgot password</h1>
    <p style="font-size:.8rem;margin:0 0 18px 0">Enter your ID number (or e-mail address). We will send a 6-digit code to the e-mail address on your application.</p>
    <form asp-action="ForgotPassword" method="post" data-once>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="af">
            <label asp-for="Identifier">ID number or e-mail</label>
            <input asp-for="Identifier" autocomplete="username" />
            <span asp-validation-for="Identifier" class="field-error"></span>
        </div>
        <button type="submit" class="login-btn">SEND CODE</button>
    </form>
    <p class="alt"><a asp-action="Login">Back to log in</a></p>
</section>
