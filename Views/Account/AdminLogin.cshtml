@* Screen 04 - Administrator / officer log in. *@
@model LoginViewModel
@{ ViewData["Title"] = "Administrator log in"; ViewData["Mode"] = "auth"; }
<section class="auth-card">
    <img class="bars" src="~/images/mangaung-mark.png" alt="Mangaung" />   
    <h1>Admin log in</h1>
    <form asp-action="AdminLogin" method="post" data-once>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="af">
            <label asp-for="Identifier">E-mail address</label>
            <input asp-for="Identifier" type="email" autocomplete="username" />
            <span asp-validation-for="Identifier" class="field-error"></span>
        </div>
        <div class="af">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <a class="forgot" asp-controller="Account" asp-action="ForgotPassword">Forgot Password</a>
        <button type="submit" class="login-btn">LOG IN</button>
    </form>
    <p class="alt">Not an administrator. <a asp-action="Login">Go to user log in</a></p>
</section>
