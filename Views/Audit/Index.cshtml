@* Screen 40 - Audit log (administrator only). *@
@model PaginatedList<AuditLog>
@{ ViewData["Title"] = "Audit log"; }
<div class="page-head"><h1>Audit log</h1><p>Record history: who changed what, and when</p></div>
<div class="table-wrap">
    <table class="grid">
        <thead><tr><th>When</th><th>User</th><th>Action</th><th>Record</th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr><td>@a.When.ToString("dd MMM yyyy HH:mm")</td><td>@a.UserName</td><td>@a.Action</td><td>@a.RecordRef</td></tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="4" class="muted">No entries.</td></tr> }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />
