@* Screen 31 - Applications (view only: the system decides). *@
@model PaginatedList<PtoApplication>
@{ var filters = new[] { "All", "Pending", "Approved", "Rejected" }; ViewData["Title"] = "Applications"; ViewBag.SearchPlaceholder = "Search name, ID or site"; }
<div class="page-head"><h1>Applications</h1><p>Search and filter</p></div>
<section class="panel wide flat">
    <div class="panel-body">
        <partial name="_ListToolbar" model="filters" />
        <div class="table-wrap">
            <table class="grid">
                <thead><tr><th>Applicant</th><th>Site</th><th>Settlement</th><th>Submitted</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><a asp-action="Detail" asp-route-id="@a.Id">@a.Beneficiary.FullName</a></td>
                        <td>@(a.Site != null ? a.Site.SiteNumber : "-")</td>
                        <td>@a.Settlement</td>
                        <td>@(a.SubmittedAt.HasValue ? (a.SubmittedAt.Value.Date == DateTime.Today ? "Today" : a.SubmittedAt.Value.Date == DateTime.Today.AddDays(-1) ? "Yesterday" : (DateTime.Today - a.SubmittedAt.Value.Date).Days < 8 ? (DateTime.Today - a.SubmittedAt.Value.Date).Days + " days ago" : a.SubmittedAt.Value.ToString("dd MMM yyyy")) : "-")</td>
                        <td><partial name="_StatusBadge" model="@(a.ApprovedAt.HasValue && a.Status == PtoStatus.Active ? "Approved" : a.Status)" /></td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="5" class="muted">No applications found.</td></tr> }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model" />
    </div>
</section>
