@* Screen 34 - PTO records. *@
@model PaginatedList<PtoApplication>
@{ var filters = new[] { "All", "Active", "Expiring", "Expired", "Renewed", "De-registered" }; ViewData["Title"] = "PTO records"; ViewBag.SearchPlaceholder = "Search"; }
<div class="page-head"><h1>PTO records</h1><p>Search by status, expiry, settlement or site</p></div>
<section class="panel wide flat">
    <div class="panel-body">
        <partial name="_ListToolbar" model="filters" />
        <div class="table-wrap">
            <table class="grid">
                <thead><tr><th>PTO ref</th><th>Beneficiary</th><th>Site</th><th>Expiry</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><a asp-action="Detail" asp-route-id="@a.Id">@(a.PtoNumber ?? a.ReferenceNumber)</a></td>
                        <td>@a.Beneficiary.FullName</td>
                        <td>@(a.Site != null ? a.Site.SiteNumber : "-")</td>
                        <td>@(a.ExpiryDate.HasValue ? a.ExpiryDate.Value.ToString("dd MMM yyyy") : "-")</td>
                        <td><partial name="_StatusBadge" model="a.Status" /></td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="5" class="muted">No PTO records found.</td></tr> }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model" />
    </div>
</section>
