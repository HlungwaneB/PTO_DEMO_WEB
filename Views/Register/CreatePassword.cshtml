@* Wireframe 24 - Create Password. Shown after Dependent information, or straight after Contact
   when the applicant has no dependants. The reference number is the ID number and is also the log-in name. *@
@model CreatePasswordViewModel
@{ ViewData["Title"] = "Create password"; }
<section class="panel">
    <div class="panel-head">PTO Application</div>
    <form asp-action="CreatePassword" method="post" data-once>
        <div class="panel-body">
            <div class="sec-title" style="font-size:1.2rem">Create Password</div>
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="field">
                <span class="label">Reference number (your ID number)</span>
                <div><b>@Model.IdNumber</b></div>
                <div class="hint">You will log in with this number and the password below.</div>
            </div>
            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" autocomplete="new-password" />
                <div class="hint">At least 8 characters with an upper-case letter, a lower-case letter and a number.</div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>
        <div class="panel-foot">
            <button type="submit" class="btn">Save and Continue</button>
            <a class="btn" asp-controller="@(Model.HasDependants ? "Register" : "Apply")" asp-action="@(Model.HasDependants ? "Dependants" : "Contact")">Back</a>
            <a class="btn" asp-controller="Apply" asp-action="Cancel">Cancel</a>
        </div>
    </form>
</section>
